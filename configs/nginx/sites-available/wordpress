server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name networkkeroro.duckdns.org keroronetwork.duckdns.org 172.197.160.163 localhost;

    client_max_body_size 8M;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # =====================================================
    # Security Logging
    # =====================================================

    access_log /var/log/nginx/security_access.log
               security_json
               if=$security_loggable;

    error_log /var/log/nginx/security_error.log warn;

    # =====================================================
    # Anti-Enumeration & Edge User Protection
    # =====================================================

    # Block author parameter enumeration (?author=1, ?author=N)
    if ($arg_author ~* "^[0-9]+$") {
        return 404;
    }

    # Block REST user enumeration query strings (?rest_route=/wp/v2/users...)
    if ($arg_rest_route ~* "(^|/|%2f)wp(/|%2f)v2(/|%2f)users") {
        return 403;
    }

    # Block direct /author/ archive URLs
    location ^~ /author/ {
        return 404;
    }

    # Block direct REST API user path unless logged in
    location ~* ^/wp-json/wp/v2/users {
        if ($http_cookie !~* "wordpress_logged_in_") {
            return 403;
        }
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Block information disclosure & obsolete files
    location ~* ^/(?:readme\.html|license\.txt|wp-config-sample\.php|index\.nginx-debian\.html|wp-trackback\.php|wp-links-opml\.php|wp-mail\.php)$ {
        return 404;
    }

    # Block direct folder directory probing
    location ~* ^/wp-content/(?:plugins|themes)/?$ {
        return 403;
    }

    # Protect wp-cron.php against external HTTP DoS abuse (system cron handles this via CLI)
    location = /wp-cron.php {
        allow 127.0.0.1;
        deny all;
    }

    # Protect administrative install and upgrade scripts
    location = /wp-admin/install.php {
        if ($http_cookie !~* "wordpress_logged_in_") {
            return 403;
        }
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /wp-admin/upgrade.php {
        if ($http_cookie !~* "wordpress_logged_in_") {
            return 403;
        }
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =====================================================
    # WordPress Login
    # =====================================================
    location = /xmlrpc.php {
        return 403;
    }

    location = /wp-login.php {
        limit_req zone=wp_login_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8080;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =====================================================
    # WordPress Admin
    # =====================================================
    location ^~ /wp-admin/ {
        limit_req zone=admin_limit burst=40 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8080;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static assets bounded budget
    location ~* ^/(?:wp-includes|wp-content)/.*\.(?:css|js|mjs|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$ {
        limit_req zone=static_limit burst=200 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =====================================================
    # Security Dashboard
    # =====================================================
    location ~* ^/security-dashboard/(?:\.|.*(?:\.bak(?:\..*)?|~|\.swp|\.tmp|\.map)$) {
        return 404;
    }

    location ^~ /security-dashboard/api/ {
        auth_basic "Security Dashboard";
        auth_basic_user_file /etc/nginx/.security-dashboard;
        auth_delay 1s;

        limit_except GET POST { deny all; }

        limit_req zone=security_api_limit burst=10 nodelay;
        limit_req_status 429;
        limit_conn dashboard_conn 8;
        client_max_body_size 4k;

        include /etc/nginx/snippets/security-dashboard-headers.conf;
        add_header Cache-Control "no-store" always;

        proxy_pass http://unix:/run/security-ai/api.sock:;
        proxy_set_header Host $host;
        proxy_set_header X-Auth-User $remote_user;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location /security-dashboard/ {
        alias /var/www/security-dashboard/;
        index index.html;

        auth_basic "Security Dashboard";
        auth_basic_user_file /etc/nginx/.security-dashboard;
        auth_delay 1s;

        limit_except GET HEAD { deny all; }

        limit_req zone=dashboard_limit burst=15 nodelay;
        limit_req_status 429;
        limit_conn dashboard_conn 12;

        include /etc/nginx/snippets/security-dashboard-headers.conf;
        add_header Cache-Control "private, no-cache" always;

        try_files $uri $uri/ /security-dashboard/index.html;
    }

    # =====================================================
    # Public WordPress Website
    # =====================================================
    location / {
        limit_req zone=web_limit burst=30 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8080;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =====================================================
    # TLS
    # =====================================================
    ssl_certificate /etc/letsencrypt/live/networkkeroro.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/networkkeroro.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;

    server_name networkkeroro.duckdns.org keroronetwork.duckdns.org 172.197.160.163 localhost;

    return 301 https://networkkeroro.duckdns.org$request_uri;
}
