[Unit]
Description=Security dashboard administration API
After=network.target

[Service]
Type=simple
User=azureuser
Group=www-data
WorkingDirectory=/opt/security-ai
RuntimeDirectory=security-ai
RuntimeDirectoryMode=0770
ExecStart=/usr/bin/python3 /opt/security-ai/security_admin_api.py
Restart=on-failure
RestartSec=2s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
