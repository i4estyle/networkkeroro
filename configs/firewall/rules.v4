# Generated by iptables-save v1.8.10 (nf_tables)
*security
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A OUTPUT -d 168.63.129.16/32 -p tcp -m tcp --dport 53 -j ACCEPT
-A OUTPUT -d 168.63.129.16/32 -p tcp -m owner --uid-owner 0 -j ACCEPT
-A OUTPUT -d 168.63.129.16/32 -p tcp -m conntrack --ctstate INVALID,NEW -j DROP
COMMIT

*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
# Active attack mitigation ipset drops
-A INPUT -p tcp -m multiport --dports 80,443 -m set --match-set security_permanent_v4 src -j DROP
-A INPUT -p tcp -m multiport --dports 80,443 -m set --match-set security_cooldown_v4 src -j DROP

# Geo-blocking allowlist (Thailand IPv4 CIDR blocks only)
-A INPUT -p tcp -m tcp --dport 443 -m set --match-set THAILAND src -j ACCEPT
-A INPUT -p tcp -m tcp --dport 80 -m set --match-set THAILAND src -j ACCEPT
-A INPUT -p tcp -m tcp --dport 22 -m set --match-set THAILAND src -j ACCEPT

# State and local loopback
-A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT
-A INPUT -p icmp -j ACCEPT
-A INPUT -i lo -j ACCEPT
-A INPUT -j REJECT --reject-with icmp-host-prohibited
COMMIT
